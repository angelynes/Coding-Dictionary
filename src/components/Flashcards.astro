---
/**
 * Flip-card deck. Click the card (or press Space) to flip.
 * Text inside `backticks` shows as code.
 */
interface Card {
	q: string;
	a: string;
	/** Optional: where the card came from (shown on the /revise page). */
	source?: string;
	href?: string;
}
interface Props {
	cards: Card[];
}
const { cards } = Astro.props;
---

<flash-cards class="not-content" data-cards={JSON.stringify(cards)}>
	<div class="fc-top">
		<span class="fc-count"></span>
		<span class="fc-score"></span>
	</div>
	<button type="button" class="fc-card" aria-label="Flashcard. Click to flip.">
		<span class="fc-inner">
			<span class="fc-face fc-front"><span class="fc-label">Question</span><span class="fc-text"></span></span>
			<span class="fc-face fc-back"><span class="fc-label">Answer</span><span class="fc-text"></span><a class="fc-src" hidden></a></span>
		</span>
	</button>
	<div class="fc-done" hidden>
		<p>🎉 Round finished! You knew <strong class="fc-known-n"></strong> of <strong class="fc-total-n"></strong>.</p>
	</div>
	<div class="fc-controls">
		<button type="button" data-act="prev" aria-label="Previous card">←</button>
		<button type="button" data-act="again">↺ Review again</button>
		<button type="button" data-act="known" class="fc-primary">✓ Got it</button>
		<button type="button" data-act="next" aria-label="Next card">→</button>
		<span class="fc-spacer"></span>
		<button type="button" data-act="shuffle">Shuffle</button>
		<button type="button" data-act="restart">Restart</button>
	</div>
</flash-cards>

<style>
	flash-cards {
		display: block;
		max-width: 44rem;
	}
	.fc-top {
		display: flex;
		justify-content: space-between;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin-bottom: 0.4rem;
	}
	.fc-card {
		display: block;
		width: 100%;
		min-height: 13rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
		perspective: 1200px;
		font: inherit;
		color: inherit;
		text-align: start;
	}
	.fc-card[hidden],
	.fc-done[hidden] {
		display: none;
	}
	.fc-inner {
		position: relative;
		display: grid;
		min-height: 13rem;
		transition: transform 0.45s ease;
		transform-style: preserve-3d;
	}
	.fc-card.is-flipped .fc-inner {
		transform: rotateY(180deg);
	}
	@media (prefers-reduced-motion: reduce) {
		.fc-inner {
			transition: none;
		}
	}
	.fc-face {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.6rem;
		padding: 1.4rem 1.6rem;
		border-radius: 0.8rem;
		border: 1px solid var(--cd-card-border);
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.fc-front {
		background: var(--cd-card-bg);
	}
	.fc-back {
		background: var(--cd-term-bg);
		transform: rotateY(180deg);
	}
	.fc-label {
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-accent);
		font-weight: 600;
	}
	.fc-text {
		font-size: var(--sl-text-lg);
		line-height: 1.5;
		white-space: pre-wrap;
		color: var(--sl-color-white);
	}
	.fc-text :global(code) {
		font-size: 0.88em;
		background: var(--sl-color-gray-6);
		padding: 0.05em 0.35em;
		border-radius: 0.25em;
	}
	.fc-src {
		font-size: var(--sl-text-xs);
	}
	.fc-done {
		padding: 2.5rem 1.5rem;
		text-align: center;
		border: 1px dashed var(--cd-card-border);
		border-radius: 0.8rem;
	}
	.fc-controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.7rem;
		align-items: center;
	}
	.fc-spacer {
		flex: 1;
	}
	.fc-controls button {
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
		border-radius: 0.4rem;
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--cd-card-border);
		background: var(--cd-card-bg);
		color: var(--sl-color-gray-2);
	}
	.fc-controls button:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}
	.fc-controls .fc-primary {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}
	:global(:root[data-theme='light']) .fc-controls .fc-primary {
		color: #fff;
	}
</style>

<script>
	interface Card {
		q: string;
		a: string;
		source?: string;
		href?: string;
	}

	function render(text: string) {
		const esc = text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
		return esc.replace(/`([^`]+)`/g, '<code>$1</code>');
	}

	class FlashCards extends HTMLElement {
		all: Card[] = [];
		deck: Card[] = [];
		i = 0;
		known = 0;

		connectedCallback() {
			this.all = JSON.parse(this.dataset.cards || '[]');
			this.restart(false);
			const card = this.querySelector<HTMLButtonElement>('.fc-card')!;
			card.addEventListener('click', (e) => {
				if ((e.target as HTMLElement).closest('a')) return;
				card.classList.toggle('is-flipped');
			});
			card.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight') this.move(1);
				if (e.key === 'ArrowLeft') this.move(-1);
			});
			this.querySelector('.fc-controls')!.addEventListener('click', (e) => {
				const act = (e.target as HTMLElement).closest('button')?.dataset.act;
				if (act === 'next') this.move(1);
				if (act === 'prev') this.move(-1);
				if (act === 'again') this.again();
				if (act === 'known') this.gotIt();
				if (act === 'shuffle') this.restart(true);
				if (act === 'restart') this.restart(false);
			});
		}

		restart(shuffle: boolean) {
			this.deck = [...this.all];
			if (shuffle) {
				for (let j = this.deck.length - 1; j > 0; j--) {
					const k = Math.floor(Math.random() * (j + 1));
					[this.deck[j], this.deck[k]] = [this.deck[k], this.deck[j]];
				}
			}
			this.i = 0;
			this.known = 0;
			this.show();
		}

		move(d: number) {
			if (!this.deck.length) return;
			this.i = (this.i + d + this.deck.length) % this.deck.length;
			this.show();
		}

		gotIt() {
			if (!this.deck.length) return;
			this.deck.splice(this.i, 1);
			this.known++;
			if (this.i >= this.deck.length) this.i = 0;
			this.show();
		}

		again() {
			// Send this card to the back of the deck.
			if (this.deck.length < 2) return this.show();
			const [c] = this.deck.splice(this.i, 1);
			this.deck.push(c);
			if (this.i >= this.deck.length) this.i = 0;
			this.show();
		}

		show() {
			const card = this.querySelector<HTMLElement>('.fc-card')!;
			const done = this.querySelector<HTMLElement>('.fc-done')!;
			card.classList.remove('is-flipped');
			const total = this.all.length;
			this.querySelector('.fc-score')!.textContent = `✓ ${this.known} known`;
			if (!this.deck.length) {
				card.hidden = true;
				done.hidden = false;
				this.querySelector('.fc-known-n')!.textContent = String(this.known);
				this.querySelector('.fc-total-n')!.textContent = String(total);
				this.querySelector('.fc-count')!.textContent = `${total} cards`;
				return;
			}
			card.hidden = false;
			done.hidden = true;
			const c = this.deck[this.i];
			this.querySelector('.fc-count')!.textContent = `Card ${this.i + 1} of ${this.deck.length} left`;
			this.querySelector('.fc-front .fc-text')!.innerHTML = render(c.q);
			this.querySelector('.fc-back .fc-text')!.innerHTML = render(c.a);
			const src = this.querySelector<HTMLAnchorElement>('.fc-src')!;
			src.hidden = !c.href;
			if (c.href) {
				src.href = c.href;
				src.textContent = `From: ${c.source} →`;
			}
		}
	}
	customElements.define('flash-cards', FlashCards);
</script>
