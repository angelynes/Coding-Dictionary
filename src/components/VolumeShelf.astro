---
/**
 * The home page shelf: one card per dictionary, with its topic count.
 */
import { getCollection } from 'astro:content';
import { volumes, volumeNumber } from '../volumes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs');
const topicCount = (id: string) => docs.filter((d) => d.id === id || d.id.startsWith(`${id}/`)).length;
---

<div class="cd-shelf not-content">
	{
		volumes.map((v, i) => {
			const n = topicCount(v.id);
			return (
				<a class="cd-book" href={`${base}/${v.id}/`} style={v.spine ? `--spine: ${v.spine}` : undefined}>
					<span class="cd-spine" aria-hidden="true" />
					<span class="cd-book-body">
						<span class="cd-smallcaps cd-book-vol">Volume {volumeNumber(i)}</span>
						<span class="cd-book-name">{v.name}</span>
						<span class="cd-book-count">
							{n} {n === 1 ? 'topic' : 'topics'}
						</span>
						<span class="cd-book-desc">{v.description}</span>
					</span>
				</a>
			);
		})
	}
</div>

<style>
	.cd-shelf {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.cd-book {
		display: flex;
		min-height: 15rem;
		background: var(--sl-color-gray-6);
		border: 1px solid var(--cd-card-border);
		border-radius: 0.25rem;
		overflow: hidden;
		text-decoration: none;
		color: var(--sl-color-white);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.cd-book:hover {
		transform: translateY(-3px);
		box-shadow: 0 10px 24px rgb(40 30 15 / 0.12);
	}
	.cd-book:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 3px;
	}
	.cd-spine {
		width: 0.85rem;
		flex: none;
		background: var(--spine, var(--cd-spine));
	}
	.cd-book-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.75rem 1.6rem;
	}
	.cd-book-vol {
		font-size: var(--sl-text-lg);
	}
	.cd-book-name {
		font-size: 3rem;
		font-weight: 500;
		line-height: 1;
	}
	.cd-book-count {
		font-style: italic;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	.cd-book-desc {
		margin-top: auto;
		font-size: var(--sl-text-lg);
		line-height: 1.3;
		color: var(--sl-color-gray-3);
	}
</style>
