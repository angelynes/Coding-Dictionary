---
/**
 * Page content, plus a link to revise this page's flashcards
 * in its dictionary's Revise room.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { findVolume } from '../../volumes';

const route = Astro.locals.starlightRoute;
const cards = (route.entry.data as { flashcards?: { q: string; a: string }[] }).flashcards ?? [];
const volume = findVolume(route.id.split('/')[0]);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = volume ? `${base}/${volume.id}/revise/?topic=${encodeURIComponent(route.id)}` : undefined;
---

<Default><slot /></Default>
{
	cards.length > 0 && href && (
		<a class="cd-revise-link not-content" href={href}>
			<span class="cd-smallcaps">Check yourself</span>
			<span class="cd-revise-text">
				{cards.length} flashcards for this topic
			</span>
			<span class="cd-revise-go">Revise them ›</span>
		</a>
	)
}

<style>
	.cd-revise-link {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		margin-top: 3rem;
		padding: 1rem 1.25rem;
		border: 1px dashed var(--cd-card-border);
		border-radius: 0.5rem;
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.cd-revise-link:hover {
		border-style: solid;
		border-color: var(--sl-color-accent);
	}
	.cd-revise-link .cd-smallcaps {
		font-size: var(--sl-text-sm);
	}
	.cd-revise-text {
		font-size: var(--sl-text-lg);
	}
	.cd-revise-go {
		margin-inline-start: auto;
		color: var(--sl-color-accent);
	}
</style>
