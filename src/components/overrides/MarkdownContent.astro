---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import Flashcards from '../Flashcards.astro';

const route = Astro.locals.starlightRoute;
const cards = (route.entry.data as { flashcards?: { q: string; a: string }[] }).flashcards ?? [];
---

<Default><slot /></Default>
{
	cards.length > 0 && (
		<section class="cd-page-cards" aria-labelledby="cd-revise-heading">
			<h2 id="cd-revise-heading">Revise this page</h2>
			<Flashcards cards={cards} />
		</section>
	)
}

<style>
	.cd-page-cards {
		margin-top: 3rem;
	}
	.cd-page-cards h2 {
		font-size: var(--sl-text-xl);
		margin-bottom: 0.8rem;
	}
</style>
