---
/**
 * Sidebar with the dictionary's name on top (and a switch to the other
 * dictionaries), the topics in the middle, and the colour key at the bottom.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
import Legend from '../Legend.astro';
import { volumes, findVolume } from '../../volumes';

const route = Astro.locals.starlightRoute;
const volume = findVolume(route.id.split('/')[0]);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
	volume && (
		<div class="cd-vol">
			<a class="cd-back" href={`${base}/`}>‹ All dictionaries</a>
			<p class="cd-vol-name">
				<span class="cd-smallcaps">Vol. {volume.number}</span>
				<span>{volume.name}</span>
			</p>
			{volumes.length > 1 && (
				<nav class="cd-switch" aria-label="Dictionaries">
					{volumes.map((v) => (
						<a href={`${base}/${v.id}/`} aria-current={v.id === volume.id ? 'true' : undefined}>
							{v.name}
						</a>
					))}
				</nav>
			)}
			<span class="cd-smallcaps cd-contents">Contents</span>
		</div>
	)
}

<Default />

{
	volume && (
		<div class="cd-key">
			<span class="cd-smallcaps">Key</span>
			<Legend />
		</div>
	)
}

<style>
	.cd-vol {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		margin-bottom: 0.25rem;
	}
	.cd-back {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.cd-back:hover {
		color: var(--sl-color-white);
	}
	.cd-vol-name {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0;
		font-size: var(--sl-text-2xl);
		font-weight: 500;
		color: var(--sl-color-white);
	}
	.cd-vol-name .cd-smallcaps {
		font-size: var(--sl-text-sm);
	}
	.cd-switch {
		display: flex;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: var(--sl-color-gray-6);
	}
	.cd-switch a {
		flex: 1;
		text-align: center;
		padding: 0.4rem 0.6rem;
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		text-decoration: none;
		color: var(--sl-color-gray-2);
	}
	.cd-switch a[aria-current] {
		background: var(--sl-color-white);
		color: var(--sl-color-black);
	}
	.cd-contents {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
	}
	.cd-key {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--cd-rule);
		font-size: var(--sl-text-sm);
	}
</style>
