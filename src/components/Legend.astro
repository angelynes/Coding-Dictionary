<p class="cd-legend" aria-label="Colour legend">
	<span class="cd-value">Value</span>
	<span aria-hidden="true">|</span>
	<span class="cd-code-word">CODE</span>
	<span aria-hidden="true">|</span>
	<span class="cd-concept">CONCEPT</span>
	<span aria-hidden="true">|</span>
	<span class="cd-keyword">keyword</span>
</p>
<style>
	.cd-legend {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--cd-card-border);
		border-radius: 999px;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.cd-code-word {
		color: var(--sl-color-white);
		font-family: var(--__sl-font-mono);
	}
</style>
