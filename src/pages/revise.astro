---
/**
 * /revise/ : pick which dictionary to revise.
 * Each dictionary has its own Revise room at /<dictionary>/revise/.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { volumes, volumeNumber } from '../volumes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs');
const count = (id: string) =>
	docs
		.filter((d) => d.id === id || d.id.startsWith(`${id}/`))
		.reduce((n, d) => n + (d.data.flashcards?.length ?? 0), 0);
---

<StarlightPage frontmatter={{ title: 'Revise', description: 'Pick a dictionary to revise.', tableOfContents: false }}>
	<p>Pick a dictionary, then choose which topics to study.</p>
	<div class="cd-revise-pick not-content">
		{
			volumes.map((v, i) => (
				<a href={`${base}/${v.id}/revise/`}>
					<span class="cd-smallcaps">Volume {volumeNumber(i)}</span>
					<span class="cd-name">Revise {v.name}</span>
					<span class="cd-n">{count(v.id)} flashcards</span>
				</a>
			))
		}
	</div>
</StarlightPage>

<style>
	.cd-revise-pick {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}
	.cd-revise-pick a {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1.25rem 1.4rem;
		border: 1px solid var(--cd-card-border);
		border-left: 0.6rem solid var(--cd-spine);
		border-radius: 0.25rem;
		background: var(--sl-color-gray-6);
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.cd-revise-pick a:hover {
		border-color: var(--sl-color-accent);
	}
	.cd-name {
		font-size: var(--sl-text-2xl);
		font-weight: 500;
	}
	.cd-n {
		font-style: italic;
		color: var(--sl-color-gray-3);
	}
</style>
